@tool
extends EditorPlugin

var _dock: VBoxContainer
var _kind: OptionButton
var _width: SpinBox
var _height: SpinBox
var _paint_btn: Button
var _painting := false
var _level_index := 1


func _enter_tree() -> void:
	_dock = VBoxContainer.new()
	var title := Label.new()
	title.text = "灰盒画笔"
	_dock.add_child(title)
	_kind = OptionButton.new()
	for k in ["terrain", "hazard", "crystal", "spring", "breakable", "jelly", "checkpoint"]:
		_kind.add_item(k)
	_dock.add_child(_kind)
	_width = SpinBox.new()
	_width.min_value = 4
	_width.max_value = 256
	_width.step = 4
	_width.value = 8
	_dock.add_child(_width)
	_height = SpinBox.new()
	_height.min_value = 4
	_height.max_value = 256
	_height.step = 4
	_height.value = 8
	_dock.add_child(_height)
	_paint_btn = Button.new()
	_paint_btn.text = "开始绘制（左键）"
	_paint_btn.toggle_mode = true
	_paint_btn.toggled.connect(_on_toggle)
	_dock.add_child(_paint_btn)
	var nb := Button.new()
	nb.text = "新建关卡"
	nb.pressed.connect(_on_new_level)
	_dock.add_child(nb)
	var init_btn := Button.new()
	init_btn.text = "初始化当前场景"
	init_btn.pressed.connect(_on_init_scene)
	_dock.add_child(init_btn)
	var save_btn := Button.new()
	save_btn.text = "保存当前场景"
	save_btn.pressed.connect(_on_save_scene)
	_dock.add_child(save_btn)
	_status = Label.new()
	_status.text = "未绘制"
	_dock.add_child(_status)
	var hint := Label.new()
	hint.text = "地形=8px 格；机关=4px 步进"
	_dock.add_child(hint)
	add_control_to_dock(DOCK_SLOT_LEFT_UL, _dock)


func _exit_tree() -> void:
	if _dock:
		remove_control_from_docks(_dock)
		_dock.queue_free()


func _on_toggle(on: bool) -> void:
	_painting = on
	_paint_btn.text = "停止绘制" if on else "开始绘制（左键）"


func _on_new_level() -> void:
	while FileAccess.file_exists("res://scenes/levels/level_%02d.tscn" % _level_index):
		_level_index += 1
	var dst := "res://scenes/levels/level_%02d.tscn" % _level_index
	DirAccess.copy_absolute(
		ProjectSettings.globalize_path("res://scenes/levels/graybox_template.tscn"),
		ProjectSettings.globalize_path(dst))
	EditorInterface.get_resource_filesystem().scan()
	EditorInterface.open_scene_from_path.call_deferred(dst)
	print("[graybox] 新建关卡: ", dst)


func _forward_canvas_gui_input(event: InputEvent) -> bool:
	if not _painting:
		return false
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		_paint(event.position)
		return true
	if event is InputEventMouseMotion and (event.button_mask & MOUSE_BUTTON_MASK_LEFT) != 0:
		_paint(event.position)
		return true
	return false


func _paint(screen_pos: Vector2) -> void:
	var root := EditorInterface.get_edited_scene_root()
	if root == null:
		return
	var vp := EditorInterface.get_editor_viewport_2d()
	var world: Vector2 = (vp.get_canvas_transform().affine_inverse() * screen_pos) if vp else screen_pos
	var kind: String = _kind.get_item_text(_kind.selected)
	if kind == "terrain":
		var layer := root.get_node_or_null("Terrain") as TileMapLayer
		if layer:
			layer.set_cell(Vector2i(int(floor(world.x / 8.0)), int(floor(world.y / 8.0))), 0, Vector2i(0, 0))
		return
	if root.get_node_or_null("Terrain") == null:
		return
	var node := Node2D.new()
	node.set_script(load("res://scripts/components/graybox_entity.gd"))
	node.set("kind", kind)
	node.set("size_px", Vector2(_width.value, _height.value))
	node.position = Vector2(snapped(world.x, 4.0), snapped(world.y, 4.0))
	root.add_child(node)
	node.owner = root


func _on_init_scene() -> void:
	var root := EditorInterface.get_edited_scene_root()
	if root == null:
		push_warning("先打开/新建一个场景")
		return
	if not (root is Node2D):
		push_warning("根节点必须是 Node2D")
		return
	if root.get_script() == null:
		root.set_script(load("res://scripts/levels/graybox_level.gd"))
	if root.get_node_or_null("Terrain") == null:
		var layer := TileMapLayer.new()
		layer.name = "Terrain"
		layer.tile_set = load("res://assets/graybox/graybox_tileset.tres")
		root.add_child(layer)
		layer.owner = root
	if root.get_node_or_null("Spawn") == null:
		var spawn := Marker2D.new()
		spawn.name = "Spawn"
		spawn.position = Vector2(16, 0)
		root.add_child(spawn)
		spawn.owner = root
	if root.get_node_or_null("Goal") == null:
		var goal := Marker2D.new()
		goal.name = "Goal"
		goal.position = Vector2(120, 0)
		root.add_child(goal)
		goal.owner = root
	EditorInterface.mark_scene_as_unsaved()
	print("[graybox] 场景已初始化")
